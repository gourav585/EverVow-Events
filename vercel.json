{
  "version": 2,
  "routes": [
    {
      "src": "/api/contact",
      "dest": "/api/contact.js"
    },
    {
      "src": "/$",
      "dest": "/index.html"
    },
    {
      "src": "/gallery$",
      "dest": "/gallery.html"
    },
    {
      "src": "/video$",
      "dest": "/video.html"
    },
    {
      "src": "/privacy$",
      "dest": "/privacy.html"
    },
    {
      "src": "/terms$",
      "dest": "/terms.html"
    },
    {
      "src": "/(.*\\.(?:html|css|js|png|jpg|jpeg|webp|svg|mp4|xml|txt|ico))",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
